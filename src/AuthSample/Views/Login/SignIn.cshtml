@{
    ViewData["Title"] = "Sign In";
}

<div class="container forms">

    <div class="card">

        <div class="card-header border-secondary">
            <h1 class="m-0 fs-2">Sign in</h1>
        </div>

        <div class="card-body">

            <form id="login-form" asp-controller="" asp-action="" method="post" class="needs-validation" novalidate>

                <div class="row">

                    <!-- Campo Login -->
                    <div class="col-md-12 form-group floating-label">
                        <div class="position-relative">
                            <input class="form-control border-secondary" id="login-name" autocomplete="off" name="Login" data-validation-rules="required, min-length" data-min-length="6" required>
                            <label for="login-name" class="floating-label-text">Enter your username:</label>
                            <div class="invalid-tooltip" hidden></div>
                        </div>
                    </div>

                    <!-- Campo Senha -->
                    <div class="col-md-12 form-group floating-label">
                        <div class="position-relative">
                            <input class="form-control border-secondary" id="login-password" type="password" autocomplete="off" name="Password" data-validation-rules="required, pattern, min-length" data-min-length="8" aria-describedby="password-description" required>
                            <label for="login-password" class="floating-label-text">Enter your password:</label>
                            <button type="button" class="btn border-0 toggle-password bi bi-eye-slash-fill m-0" aria-label="Exibir senha" data-bs-toggle="tooltip" data-bs-placement="right" title="Click to show password"></button>
                            <div class="invalid-tooltip" hidden></div>
                        </div>
                    </div>

                </div>

                <div class="col-md-12 d-flex flex-column">
                    <button type="submit" class="btn btn-green" data-bs-toggle="tooltip" data-bs-placement="right" title="Click to sign in">Sign in</button>
                </div>

            </form>

        </div>

        <div class="card-footer mt-0 p-4 border-secondary">
            <p class="m-0">Can't you sign in ? <a class="" href="" data-bs-toggle="tooltip" data-bs-placement="bottom" title="Click to change your password."> Change your password</a>.</p>
        </div>

    </div>

</div>