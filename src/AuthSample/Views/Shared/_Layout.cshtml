<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="author" content="Gianluca Vialli Ribeiro Vieira">
    <meta name="description" content="Biblioteca .Net para autenticação de usuários e gerenciamento de sessão com permissionamento.">

    <title>Auth.NET - @ViewData["Title"]</title>

    <!-- bootstrap css -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <!-- standard css -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    <!-- custom css -->
    <link rel="stylesheet" href="~/css/dark-mode/dark-mode.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/navbar/navbar.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/components/components.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/forms/forms.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/login-page/login.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/users-page/register.css" asp-append-version="true" />

</head>
<body>

    <header>
        <nav class="navbar navbar-light border-bottom border-secondary border-1 fixed-top p-2">
            <div class="container-fluid">
                <button title="menu" class="btn btn-sm navbar-toggler" type="button" data-bs-toggle="offcanvas" data-bs-target="#offcanvasNavbar" aria-controls="offcanvasNavbar">
                    <svg id="toggle-icon" xmlns="http://www.w3.org/2000/svg" fill="currentColor" class="bi bi-list" viewBox="0 0 16 16">
                        <path fill-rule="evenodd" d="M2.5 12a.5.5 0 0 1 .5-.5h10a.5.5 0 0 1 0 1H3a.5.5 0 0 1-.5-.5m0-4a.5.5 0 0 1 .5-.5h10a.5.5 0 0 1 0 1H3a.5.5 0 0 1-.5-.5m0-4a.5.5 0 0 1 .5-.5h10a.5.5 0 0 1 0 1H3a.5.5 0 0 1-.5-.5" />
                    </svg>
                </button>
                <div class="offcanvas offcanvas-start" tabindex="-1" id="offcanvasNavbar" aria-labelledby="offcanvasNavbarLabel">
                    <div class="offcanvas-header">
                        <a href="#">
                            <img width="35" class="img-fluid" src="~/favicon.ico" alt="logo" />
                        </a>
                        <span class="p-0 m-auto fs-4 fw-bold">Auth.NET</span>
                        <button class="btn-close m-2" type="button" title="Close" data-bs-dismiss="offcanvas" data-bs-toggle="tooltip" data-bs-placement="bottom" aria-label="Close">
                            <svg viewBox="0 0 16 16" xmlns="http://www.w3.org/2000/svg">
                                <path d="M2 2l12 12M2 14L14 2" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
                            </svg>
                        </button>
                    </div>
                    <hr class="m-0" />
                    <div class="offcanvas-body w-100 p-auto">
                        <ul class="navbar-nav flex-grow-1">
                            <li class="nav-item">
                                <a class="nav-link" asp-area="" asp-controller="Home" asp-action="Index"><i class="bi bi-house-door"></i> Home</a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link" asp-area="" asp-controller="Home" asp-action="Privacy"><i class="bi bi-shield"></i> Privacy</a>
                            </li>
                        </ul>
                    </div>
                    <div class="offcanvas-footer">
                        <div class="col d-flex justify-content-start mt-3 mb-3">
                            <a class="btn btn-sm btn-green text-light ms-3 me-3" asp-area="" asp-controller="Login" asp-action="SignIn">Sign in</a>
                            <a class="btn btn-sm btn-secondary text-light" asp-area="" asp-controller="User" asp-action="Register">Sign up</a>
                        </div>
                    </div>
                </div>
                <!-- Botão de alternância para o modo claro/escuro -->
                <div class="theme-toggle ms-3 me-3">
                    <button id="theme-toggle" class="toggle-btn">
                        <div class="slider">
                            <span class="icon-sun">☀️</span>
                            <span class="icon-moon">🌙</span>
                            <div class="circle"></div>
                        </div>
                    </button>
                </div>
            </div>
        </nav>
    </header>

    <main role="main" class="container-fluid">
        @RenderBody()
    </main>

    <footer class="footer">
        <div class="container">
            <span>
                &copy; @DateTime.Now.ToString("yyyy") - Auth.NET
                <i class="bi bi-cpu-fill ms-2 me-1"></i> Developed by - <a href="https://github.com/GianLost" aria-label="Contact us on Github" target="_blank"> &copy; Gianluca Vialli</a> <a href="https://www.linkedin.com/in/gianluca-vialli-5a2a8a226/" aria-label="Contact us on LinkedIn" target="_blank"> <i class="bi bi-linkedin text-primary ms-1"></i> </a> <a href="https://www.instagram.com/gianluca.vialli_ufo/" aria-label="Contact us on Instagram" target="_blank">
                    <i class="ms-2 bi bi-instagram text-danger"></i>
                </a>
            </span>
        </div>
    </footer>

    <!-- standard js -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    <!-- custom js -->
    <script type="module" src="~/js/animation/toggle-password-visibility.js" asp-append-version="true"></script>
    <script type="module" src="~/js/forms/validation/validate-form.js" asp-append-version="true"></script>
    <script src="~/js/components/tooltip.js" asp-append-version="true"></script>
    <script src="~/js/components/alert.js" asp-append-version="true"></script>
    <script src="~/js/forms/form.js" asp-append-version="true"></script>

    <!-- dark-mode js -->
    <script src="~/js/dark-mode/dark-mode.js" asp-append-version="true" defer></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>