@model User

@using Auth.NET.Libs.Entities.Users
@using Auth.NET.Libs.Helpers.Expressions
@using Auth.NET.Libs.Helpers.Messages

@{
    ViewData["Title"] = "Register user";
}

<div class="container forms">

    @* <div class="alert">
        <!-- space for alert messages component... -->
    </div> *@

    <div class="card col-md-8">

        <div class="card-body">

            <form asp-action="Register" asp-controller="User" method="post" class="needs-validation" novalidate>

                <div class="row">

                    <!-- full name field -->
                    <div class="col-md-6 form-group floating-label">
                        <div class="position-relative">
                            <input type="text" class="form-control" id="register-name" name="Name" data-validation-rules="required, min-length" data-min-length="6" autocomplete="name" asp-for="Name" required>
                            <label for="register-name" class="floating-label-text">Full name: </label>
                            <div class="invalid-tooltip"><span></span></div>
                        </div>
                    </div>

                    <!-- username field -->
                    <div class="col-md-6 form-group floating-label">
                        <div class="position-relative">
                            <input type="text" class="form-control" id="register-username" name="Login" data-validation-rules="required, min-length" data-min-length="6" autocomplete="username" asp-for="Login" required>
                            <label for="register-username" class="floating-label-text">Username: </label>
                            <div class="invalid-tooltip"><span></span></div>
                        </div>
                    </div>

                </div>

                <div class="row">

                    <!-- email address field -->
                    <div class="col-md-6 form-group floating-label">
                        <div class="position-relative">
                            <input type="email" class="form-control" id="register-email" name="Email" data-validation-rules="required, pattern" maxlength="100" data-pattern="@ConstExpressions.EmailRegex.Trim()" autocomplete="email" asp-for="Email" required>
                            <label for="register-email" class="floating-label-text">Email address: </label>
                            <div class="invalid-tooltip"><span></span></div>
                        </div>
                    </div>

                    <!-- confirm email address field -->
                    <div class="col-md-6 form-group floating-label">
                        <div class="position-relative">
                            <input type="email" class="form-control" id="confirm-email" name="confirm-email" data-validation-rules="required, confirm-email, pattern" data-pattern="@ConstExpressions.EmailRegex.Trim()" data-confirm-email-for="register-email" maxlength="100" autocomplete="email" required />
                            <label for="confirm-email" class="floating-label-text">Confirm your email address: </label>
                            <div class="invalid-tooltip"><span></span></div>
                        </div>
                    </div>

                </div>

                <div class="row">

                    <!-- password field -->
                    <div class="col-md-6 form-group floating-label">
                        <div class="position-relative">
                            <input type="password" class="form-control input-password" id="register-password" name="PasswordHash" data-validation-rules="required, pattern" minlength="8" data-pattern="@ConstExpressions.StrongPasswordRegex.Trim()" data-error-message="@ErrorMessages.MsgPasswordRegex.Trim()" autocomplete="new-password" asp-for="PasswordHash" required>
                            <label for="register-password" class="floating-label-text">Password: </label>
                            <button type="button" class="btn toggle-password bi bi-eye-slash-fill" aria-label="show password" data-bs-toggle="tooltip" data-bs-placement="right" title="Click to show password"></button>
                            <div class="invalid-tooltip"><span></span></div>
                        </div>
                    </div>

                    <!-- confirm password field -->
                    <div class="col-md-6 form-group floating-label">
                        <div class="position-relative">
                            <input type="password" class="form-control input-password" id="confirm-password" name="confirm-password" data-validation-rules="required, confirm-password" data-confirm-password-for="register-password" minlength="8" autocomplete="current-password" required />
                            <label for="confirm-password" class="floating-label-text">Confirm your password: </label>
                            <button type="button" class="btn toggle-password bi bi-eye-slash-fill" aria-label="show password" data-bs-toggle="tooltip" data-bs-placement="right" title="Click to show password"></button>
                            <div class="invalid-tooltip"><span></span></div>
                        </div>
                    </div>

                </div>

                <div class="row">

                    <!-- cellphone field -->
                    <div class="col-md-6 form-group floating-label">
                        <div class="position-relative">
                            <input type="tel" class="form-control" maxlength="15" id="register-cellphone" name="CellPhone" data-validation-rules="required, pattern" data-pattern="@ConstExpressions.PhoneNumberRegex.Trim()" autocomplete="tel" asp-for="CellPhone" required>
                            <label for="register-cellphone" class="floating-label-text">Cellphone (XX) XXXXX-XXXX </label>
                            <div class="invalid-tooltip"><span></span></div>
                        </div>
                    </div>

                    <!-- register button -->
                    <div class="w-100 col-md-12">
                        <button type="submit" class="btn btn-block btn-green" aria-label="sign up here" data-bs-toggle="tooltip" data-bs-placement="right" title="Click to register user">Sign up</button>
                    </div>

                </div>

            </form>

        </div>

    </div>

</div>