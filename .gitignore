# Ignore build directories
bin/
obj/
out/

# Ignore user-specific files
.vs/
.idea/
.vscode/

# Ignore ASP.NET Core specific files
.vscode/
.DS_Store
*.user
*.suo
*.userosscache
*.sln.docstates

# Ignore project settings and dependency caches
project.lock.json
project.fragment.lock.json
artifacts/

# Ignore NuGet packages
*.nupkg

# Local NuGet package cache
.nuget/

# NuGet v3's global packages folder
~/.nuget/packages/

# Ignore ASP.NET Temp files
~/.tmp/
~/.vs2019/
~/.vs2017/
~/.vs/

# Ignore logs
logs/
log/
*.log

# Ignore app settings in development environment
## appsettings.Development.json
## appsettings.Local.json

# Ignore secrets and sensitive data (Consider using Azure Key Vault or environment variables instead)
secrets.json
*.pem
*.key
*.pfx
*.cer

# Ignore database files
*.mdf
*.ldf
*.sqlite
*.db

# Ignore build artifacts and other temp files generated by Visual Studio
.idea/
.vscode/
.vs/

# Windows Installer files
*.cab
*.msi
*.msm
*.msp

# Ignore Rider files
.idea/

# Ignore test results
TestResults/
*.trx
*.coverage
*.coveragexml

# Ignore dotnet publish output
publish/

# Ignore dependency folders
node_modules/
bower_components/

# Ignore generated IDE files
*.sublime-workspace
*.sublime-project
*.iml

# Ignore the sample application (AuthSample) output
AuthSample/bin/
AuthSample/obj/

# Ignore unnecessary SDK and runtime packages
dotnet-tools/

# Ignore macOS Finder files
.DS_Store

# Ignore Thumbnails (Windows)
Thumbs.db

# Ignore JetBrains Rider project settings
.idea/

# Ignore files for temporary debugging or development
debug/
debugger/

# Ignore local environment variables
.env
.env.local
.env.*.local

# Ignore build files for any third-party tools used (like webpack)
dist/
*.tgz
*.gz
